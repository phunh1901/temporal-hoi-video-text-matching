{
  "protocol_version": "global_union_pair/v1",
  "scope": "development_only",
  "control": "B0_global",
  "treatment": "B1_person_object_union",
  "fixed": ["encoder_sha256", "preprocess", "frame_indices", "head_checkpoint", "pooling", "seed", "cohort_hash", "query_pool_hash", "optimizer", "train_budget"],
  "head_pairs": [["B0_frozen", "B1_frozen"], ["B0_H", "B1_H"]],
