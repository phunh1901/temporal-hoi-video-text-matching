  "caption_conditioned_selection": false,
  "full_frame_fallback": false,
  "verified_full_frame_union": "accept genuine pair; log no_local_contrast count",
  "missing_pair": "exclude under a shared locked cohort and report coverage; never substitute global frame",
  "primary_metric": "validation text_to_video R@1",
  "paired_reporting": ["both_direction R@1/5/10 and MedR", "latency", "resident_RAM", "commit", "CUDA_peak", "trainable_parameters"],
